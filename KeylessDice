local LUNA_URL = "https://raw.githubusercontent.com/Nebula-Softworks/Luna-Interface-Suite/refs/heads/master/source.lua"

local TAB_ICONS = {
	["Auto"]      = "bolt",
	["AutoHub"]   = "military_tech",
	["LevelUp"]   = "trending_up",
	["Potions"]   = "science",
	["Auto Sell"] = "shopping_cart",
	["Misc"]      = "settings",
}

local function MakeUI(cfg)
	local W = {}
	local Flags, Conns = {}, {}
	local ready, loading, dirty = false, false, false

	local function connect(sig, fn)
		local c = sig:Connect(fn)
		Conns[#Conns + 1] = c
		return c
	end
	local function fire(cb, ...)
		if not cb then return end
		local args = { ... }
		task.spawn(function()
			local ok, err = pcall(cb, table.unpack(args))
			if not ok then warn("[ShiroHub] callback error: " .. tostring(err)) end
		end)
	end
	-- Luna's :Set() takes a settings table; fall back to the raw value if it doesn't
	local function lunaSet(el, tbl, raw)
		if not el or type(el.Set) ~= "function" then return end
		local ok = pcall(el.Set, el, tbl)
		if not ok then pcall(el.Set, el, raw) end
	end

	-- config (own save file, so flags/values behave exactly like before)
	local canFile = typeof(writefile) == "function" and typeof(readfile) == "function" and typeof(isfile) == "function"
	local function save()
		if not canFile then return end
		local data = {}
		for flag, obj in pairs(Flags) do data[flag] = obj.Value end
		pcall(function()
			if typeof(makefolder) == "function" and typeof(isfolder) == "function" and not isfolder(cfg.Folder) then
				makefolder(cfg.Folder)
			end
			writefile(cfg.Folder .. "/" .. cfg.File, HttpService:JSONEncode(data))
		end)
	end
	local function changed()
		if not ready or loading or dirty then return end
		dirty = true
		task.delay(0.6, function()
			dirty = false
			save()
		end)
	end

	-- load Luna
	local okLoad, Luna = pcall(function()
		return loadstring(game:HttpGet(LUNA_URL))()
	end)
	if not okLoad or type(Luna) ~= "table" then
		error("ShiroHub: failed to load Luna UI. (" .. tostring(Luna) .. ")", 0)
	end

	local Window = Luna:CreateWindow({
		Name = cfg.Name,
		Subtitle = cfg.Version,
		LogoID = "",              -- no logo
		LoadingEnabled = false,   -- no loading screen / logo
		ConfigSettings = {
			RootFolder = nil,
			ConfigFolder = cfg.Folder,
		},
		KeySystem = false,
	})

	-- RightShift toggle
	local function lunaGui()
		local roots = {}
		pcall(function() roots[#roots + 1] = gethui() end)
		pcall(function() roots[#roots + 1] = game:GetService("CoreGui") end)
		roots[#roots + 1] = LocalPlayer:FindFirstChild("PlayerGui")
		local found = nil
		for _, r in ipairs(roots) do
			if r then
				for _, g in ipairs(r:GetChildren()) do
					if g:IsA("ScreenGui") and g.Name ~= "Luna-Old" and g:FindFirstChild("SmartWindow") then
						found = g
						break
					end
				end
			end
			if found then break end
		end
		return found
	end
	-- hide Luna's built-in profile card (avatar + name, bottom-left)
	task.spawn(function()
		for _ = 1, 20 do
			task.wait(0.25)
			local g = lunaGui()
			if g then
				-- Luna's own minimize/close buttons play a hide animation that needs a keyboard to undo,
				-- so they're hidden; the circle is the open/close button
				pcall(function()
					local win = g:FindFirstChild("SmartWindow")
					local ctl = win and win:FindFirstChild("Controls")
					if ctl and ctl:IsA("GuiObject") then ctl.Visible = false end
				end)
				local hid = false
				pcall(function()
					local win = g:FindFirstChild("SmartWindow")
					local nav = win and win:FindFirstChild("Navigation")
					local pl = nav and nav:FindFirstChild("Player")
					if pl and pl:IsA("GuiObject") then
						pl.Visible = false
						hid = true
					end
				end)
				for _, d in ipairs(g:GetDescendants()) do
					if d:IsA("TextLabel") and (d.Text == LocalPlayer.DisplayName or d.Text == LocalPlayer.Name) then
						local card = d.Parent
						if card and card:IsA("GuiObject") and card ~= g then
							card.Visible = false
							hid = true
						end
					end
				end
				if hid then break end
			end
		end
	end)
	-- open/close = turn Luna's whole gui on/off (no keyboard needed, works on mobile)
	local function toggleLuna()
		local g = lunaGui()
		if g then g.Enabled = not g.Enabled end
	end
	connect(UIS.InputBegan, function(i, gp)
		if gp or i.KeyCode ~= Enum.KeyCode.RightShift then return end
		toggleLuna()
	end)

	-- mini circle: tap to open/close the menu, drag to move (works on mobile)
	local orbGui = Instance.new("ScreenGui")
	orbGui.Name = "ShiroHubOrb"
	orbGui.ResetOnSpawn = false
	orbGui.DisplayOrder = 2000000000
	orbGui.IgnoreGuiInset = true
	orbGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	local okOrb = pcall(function() orbGui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
	if not okOrb or not orbGui.Parent then orbGui.Parent = LocalPlayer:WaitForChild("PlayerGui") end

	local orb = Instance.new("TextButton")
	orb.Name = "Orb"
	orb.Size = UDim2.fromOffset(56, 56)
	orb.Position = UDim2.new(0, 12, 0.5, -28)
	orb.BackgroundColor3 = Color3.fromRGB(124, 92, 255)
	orb.BorderSizePixel = 0
	orb.AutoButtonColor = false
	orb.Text = "≡"
	orb.TextColor3 = Color3.new(1, 1, 1)
	orb.Font = Enum.Font.GothamBold
	orb.TextSize = 28
	orb.Parent = orbGui
	local orbCorner = Instance.new("UICorner")
	orbCorner.CornerRadius = UDim.new(0.5, 0)
	orbCorner.Parent = orb
	local orbStroke = Instance.new("UIStroke")
	orbStroke.Color = Color3.fromRGB(64, 200, 255)
	orbStroke.Thickness = 2
	orbStroke.Parent = orb

	local orbDown, orbMoved, orbStartPos, orbStartIn = false, false, nil, nil
	connect(orb.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			orbDown, orbMoved, orbStartPos, orbStartIn = true, false, orb.Position, i.Position
			local c
			c = i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then
					orbDown = false
					c:Disconnect()
				end
			end)
		end
	end)
	connect(orb.Activated, function()
		if not orbMoved then toggleLuna() end
	end)
	connect(UIS.InputChanged, function(i)
		if orbDown and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - orbStartIn
			if d.Magnitude > 6 then orbMoved = true end
			if orbMoved then
				orb.Position = UDim2.new(orbStartPos.X.Scale, orbStartPos.X.Offset + d.X, orbStartPos.Y.Scale, orbStartPos.Y.Offset + d.Y)
			end
		end
	end)

	function W:Notify(t, msg, dur)
		pcall(function()
			Luna:Notification({
				Title = t,
				Icon = "notifications_active",
				ImageSource = "Material",
				Content = msg,
			})
		end)
	end

	function W:Tab(name, icon)
		local tab = {}
		local lt
		local ok, res = pcall(function()
			return Window:CreateTab({
				Name = name,
				Icon = TAB_ICONS[name] or "dashboard",
				ImageSource = "Material",
				ShowTitle = true,
			})
		end)
		if not ok then
			res = Window:CreateTab({ Name = name, ShowTitle = true })
		end
		lt = res

		function tab:Card(cardTitle)
			local card = {}
			local made = false
			-- section header is created with the first element so interleaved cards stay in order
			local function ensure()
				if made then return end
				made = true
				pcall(function() lt:CreateSection(cardTitle) end)
			end

			function card:Toggle(o)
				ensure()
				local obj = { Value = o.Default and true or false }
				local el = lt:CreateToggle({
					Name = o.Name,
					CurrentValue = obj.Value,
					Callback = function(v)
						v = v and true or false
						if v == obj.Value then return end
						obj.Value = v
						fire(o.Callback, v)
						changed()
					end,
				})
				function obj:Set(v, silent)
					obj.Value = v and true or false
					lunaSet(el, { CurrentValue = obj.Value }, obj.Value)
					if not silent then
						fire(o.Callback, obj.Value)
						changed()
					end
				end
				if o.Flag then Flags[o.Flag] = obj end
				return obj
			end

			function card:Button(o)
				ensure()
				return lt:CreateButton({
					Name = o.Name,
					Callback = function() fire(o.Callback) end,
				})
			end

			function card:Label(text)
				ensure()
				return lt:CreateLabel({ Text = text, Style = 1 })
			end

			function card:Paragraph(o)
				ensure()
				local title, content = o.Title or "", o.Content or ""
				local el = lt:CreateParagraph({ Title = title, Text = content })
				local obj = {}
				function obj:Set(v)
					if type(v) ~= "table" then return end
					if v.Title then title = v.Title end
					if v.Content then content = v.Content end
					lunaSet(el, { Title = title, Text = content }, { Title = title, Text = content })
				end
				return obj
			end

			function card:Slider(o)
				ensure()
				local min, max, step = o.Min or 0, o.Max or 100, o.Step or 1
				local obj = { Value = math.clamp(o.Default or min, min, max) }
				local function snap(v)
					v = tonumber(v) or min
					return math.clamp(math.floor((v - min) / step + 0.5) * step + min, min, max)
				end
				local el = lt:CreateSlider({
					Name = o.Name,
					Range = { min, max },
					Increment = step,
					CurrentValue = obj.Value,
					Suffix = o.Suffix,
					ValueSuffix = o.Suffix,
					Callback = function(v)
						v = snap(v)
						if v == obj.Value then return end
						obj.Value = v
						fire(o.Callback, v)
						changed()
					end,
				})
				function obj:Set(v, silent)
					obj.Value = snap(v)
					lunaSet(el, { CurrentValue = obj.Value }, obj.Value)
					if not silent then
						fire(o.Callback, obj.Value)
						changed()
					end
				end
				if o.Flag then Flags[o.Flag] = obj end
				return obj
			end

			function card:Input(o)
				ensure()
				local obj = { Value = tostring(o.Default or "") }
				local el = lt:CreateInput({
					Name = o.Name,
					PlaceholderText = o.Placeholder or "",
					CurrentValue = obj.Value,
					Numeric = false,
					Enter = true,
					Callback = function(v)
						v = tostring(v or "")
						if v == obj.Value then return end
						obj.Value = v
						fire(o.Callback, v)
						changed()
					end,
				})
				function obj:Set(v, silent)
					obj.Value = tostring(v or "")
					lunaSet(el, { CurrentValue = obj.Value }, obj.Value)
					if not silent then
						fire(o.Callback, obj.Value)
						changed()
					end
				end
				if o.Flag then Flags[o.Flag] = obj end
				return obj
			end

			function card:Dropdown(o)
				ensure()
				local multi = o.Multi and true or false
				local options = o.Options or {}

				local function norm(v)
					if multi then
						local arr = {}
						if type(v) == "table" then
							for _, n in ipairs(v) do arr[#arr + 1] = tostring(n) end
						elseif type(v) == "string" then
							arr[1] = v
						end
						return arr
					end
					if type(v) == "table" then v = v[1] end
					return v ~= nil and tostring(v) or nil
				end
				local function key(v)
					if multi then
						local c = table.clone(v)
						table.sort(c)
						return table.concat(c, "\0")
					end
					return tostring(v)
				end
				local function asOption(v)
					if multi then return v end
					return v ~= nil and { v } or {}
				end

				local obj = { Value = norm(o.Default) }
				local el = lt:CreateDropdown({
					Name = o.Name,
					Options = options,
					CurrentOption = asOption(obj.Value),
					MultipleOptions = multi,
					Callback = function(v)
						v = norm(v)
						if key(v) == key(obj.Value) then return end
						obj.Value = v
						fire(o.Callback, v)
						changed()
					end,
				})
				function obj:Set(v, silent)
					obj.Value = norm(v)
					lunaSet(el, { CurrentOption = asOption(obj.Value) }, asOption(obj.Value))
					if not silent then
						fire(o.Callback, obj.Value)
						changed()
					end
				end
				function obj:Refresh(newOptions)
					options = newOptions or {}
					pcall(function() el:Refresh(options) end)
				end
				if o.Flag then Flags[o.Flag] = obj end
				return obj
			end

			return card
		end

		return tab
	end

	function W:LoadConfig()
		if canFile then
			local ok, data = pcall(function()
				local path = cfg.Folder .. "/" .. cfg.File
				local decoded = nil
				if isfile(path) then
					decoded = HttpService:JSONDecode(readfile(path))
				end
				return decoded
			end)
			if ok and type(data) == "table" then
				loading = true
				for flag, val in pairs(data) do
					local o = Flags[flag]
					if o then pcall(o.Set, o, val) end
				end
				loading = false
			end
		end
		ready = true
	end

	function W:Destroy()
		for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
		pcall(function() Luna:Destroy() end)
		pcall(function() orbGui:Destroy() end)
		pcall(function()
			local g = lunaGui()
			if g then g:Destroy() end
		end)
	end

	return W
end

